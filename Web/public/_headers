# Cabeceras de seguridad — HookHub Web
# Compatible con Netlify y Cloudflare Pages.
# Verificar tras el despliegue con: curl -I https://<dominio>/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Astro islands necesitan scripts y estilos inline para la hidratación de React.
  # data: se permite para iconos SVG inline (ej: el botón de Google).
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'
