---
import { site } from '../config/site';

const communityLinks = [
  { key: 'repository', ...site.links.repository },
  { key: 'issues', ...site.links.issues },
  { key: 'featureRequests', ...site.links.featureRequests },
  { key: 'roadmap', ...site.links.roadmap },
  { key: 'contributing', ...site.links.contributing },
];
---

<section class="community" id="comunidad">
  <div class="container community-grid">
    <div class="community-copy" data-reveal>
      <p class="section-eyebrow">Comunidad</p>
      <h2>HookHub será un proyecto público</h2>
      <p class="section-lead">
        Cuando se publique el repositorio, cualquier persona podrá seguir la evolución del
        proyecto, reportar errores, proponer funciones y contribuir. Todavía no se han
        abierto estos canales.
      </p>
    </div>

    <ul class="community-links" data-reveal style="--reveal-i: 1">
      {
        communityLinks.map((link) => (
          <li>
            {link.url ? (
              <a
                class="community-link"
                href={link.url}
                rel="noopener noreferrer"
                target="_blank"
              >
                <span class="community-link-label">{link.label}</span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </a>
            ) : (
              <div
                class="community-link community-link-disabled"
                aria-disabled="true"
                aria-describedby={`community-note-${link.key}`}
              >
                <span class="community-link-label">{link.label}</span>
                <span class="community-link-state">No disponible</span>
              </div>
            )}
            {!link.url && (
              <p class="sr-only" id={`community-note-${link.key}`}>
                {link.unavailableReason}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .community {
    padding: var(--space-9) 0;
    background: var(--color-bg);
  }

  .community-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: start;
  }

  .section-eyebrow {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .section-lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .community-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .community-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    font-size: var(--text-sm);
    background: var(--color-bg);
    min-height: 2.75rem;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      translate var(--transition-fast);
  }

  a.community-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-soft);
    translate: 4px 0;
  }

  .community-link-disabled {
    color: var(--color-text-muted);
    border-style: dashed;
    background: var(--color-bg-soft);
    cursor: default;
  }

  .community-link-state {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  @media (max-width: 60rem) {
    .community-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 40rem) {
    .community {
      padding: var(--space-8) 0;
    }
  }
</style>
