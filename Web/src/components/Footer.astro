---
import Logo from './Logo.astro';
import { site } from '../config/site';

const year = new Date().getFullYear();

const footerNav = [
  { href: '#caracteristicas', label: 'Características' },
  { href: '#descargas', label: 'Descargas' },
  { href: '#novedades', label: 'Novedades' },
  { href: '#comunidad', label: 'Comunidad' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo />
      <p>{site.description}</p>
    </div>

    <nav class="footer-nav" aria-label="Enlaces del pie de página">
      <p class="footer-heading">Navegación</p>
      <ul>
        {
          footerNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-resources">
      <p class="footer-heading">Proyecto</p>
      <ul>
        <li>
          {
            site.links.repository.url ? (
              <a
                href={site.links.repository.url}
                rel="noopener noreferrer"
                target="_blank"
              >
                GitHub
              </a>
            ) : (
              <span class="footer-disabled" aria-disabled="true">
                GitHub · pendiente
              </span>
            )
          }
        </li>
        <li>
          {
            site.links.issues.url ? (
              <a href={site.links.issues.url} rel="noopener noreferrer" target="_blank">
                Reportar errores
              </a>
            ) : (
              <span class="footer-disabled" aria-disabled="true">
                Reportar errores · pendiente
              </span>
            )
          }
        </li>
        <li>
          {
            site.license.url ? (
              <a href={site.license.url} rel="noopener noreferrer" target="_blank">
                {site.license.name}
              </a>
            ) : (
              <span class="footer-disabled" aria-disabled="true">
                {site.license.label}
              </span>
            )
          }
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} HookHub. Proyecto en desarrollo.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    padding: var(--space-8) 0 var(--space-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-7);
    margin-bottom: var(--space-7);
  }

  .footer-brand p {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 26rem;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .footer-nav ul,
  .footer-resources ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-nav a,
  .footer-resources a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover,
  .footer-resources a:hover {
    color: var(--color-accent);
  }

  .footer-disabled {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 50rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
