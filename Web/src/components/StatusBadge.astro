---
import type { DownloadStatus } from '../config/site';
import { statusLabels, statusTones } from '../config/site';

interface Props {
  status: DownloadStatus;
  class?: string;
}
const { status, class: className } = Astro.props;
const tone = statusTones[status];
---

<span class:list={['badge', `badge-${tone}`, className]}>
  {statusLabels[status]}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.4;
    border-radius: 999px;
    border: 1px solid;
    white-space: nowrap;
  }

  .badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .badge-positive {
    color: var(--color-positive);
    border-color: color-mix(in srgb, var(--color-positive) 35%, transparent);
    background: color-mix(in srgb, var(--color-positive) 8%, var(--color-bg));
  }

  .badge-warning {
    color: var(--color-warning);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
    background: color-mix(in srgb, var(--color-warning) 8%, var(--color-bg));
  }

  .badge-accent {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg));
  }
</style>
